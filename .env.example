# Server-side only. None of these are prefixed NEXT_PUBLIC_, so Next.js never
# inlines them into the client bundle.

# Anthropic API key (https://platform.claude.com/settings/keys)
LLM_API_KEY=

# Fast, cheap model for parsing food text
LLM_PARSER_MODEL=claude-haiku-4-5
# Vision model for photo breakdowns
LLM_VISION_MODEL=claude-sonnet-5
# Stronger model for daily/weekly coaching
LLM_COACH_MODEL=claude-sonnet-5

# Optional: override the API base URL (defaults to https://api.anthropic.com)
# LLM_BASE_URL=

# Optional: require this passcode in the x-app-passcode header for /api/*
APP_PASSCODE=


# --- Accounts & sync (Supabase) ---
# Added automatically when you connect Supabase to the Vercel project
# (Vercel → Storage → Supabase). Pull them locally with: npx vercel env pull .env.local
# The anon/publishable key is public by design; row-level security protects the data.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# POSTGRES_URL=            (used only by `npm run db:setup`)
