# Server-side only. None of these are prefixed NEXT_PUBLIC_, so Next.js never
# inlines them into the client bundle.

# --- AI provider: bring any supported key ---
# The provider is inferred from the key prefix:
#   sk-... / sk-proj-... → OpenAI (defaults: gpt-6-luna, low reasoning effort)
#   sk-ant-...           → Anthropic (defaults: claude-haiku-4-5 text, claude-sonnet-5 photos/coach)
#   AIza...              → Google Gemini     gsk_... → Groq
#   sk-or-...            → OpenRouter        xai-... → xAI
LLM_API_KEY=

# Optional overrides:
# LLM_PROVIDER=openai          # openai | anthropic | gemini | groq | openrouter | deepseek | xai | mistral | compatible
# LLM_MODEL=gpt-6-luna         # one model for every task (required for providers without defaults)
# LLM_PARSER_MODEL=            # per task: food text
# LLM_VISION_MODEL=            # per task: photos (must accept images)
# LLM_COACH_MODEL=             # per task: daily/weekly review
# LLM_REASONING_EFFORT=low     # none | minimal | low | medium | high | xhigh | max (where supported)
# LLM_BASE_URL=                # required for LLM_PROVIDER=compatible (any OpenAI-compatible API)

# Optional: require this passcode in the x-app-passcode header for /api/*
APP_PASSCODE=


# --- Accounts & sync (Supabase) ---
# Added automatically when you connect Supabase to the Vercel project
# (Vercel → Storage → Supabase). Pull them locally with: npx vercel env pull .env.local
# The anon/publishable key is public by design; row-level security protects the data.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# POSTGRES_URL=            (used only by `npm run db:setup`)
